# Anthropic API key — used by the claude CLI subprocess for all AI calls
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Tavily API key (optional) — https://tavily.com (free: 1000 searches/month)
# Without this, the researcher stage skips web search and uses placeholder data.
TAVILY_API_KEY=

# ElevenLabs API key (optional) — https://elevenlabs.io
# Required for TTS audio generation; stage is skipped when absent.
ELEVENLABS_API_KEY=

# fal.ai API key (optional) — https://fal.ai
# Required for image and video generation; stages are skipped when absent.
FAL_API_KEY=

# Kling API key (optional) — fallback video generator when FAL_API_KEY is absent
KLING_API_KEY=

# Path to the claude CLI binary (optional)
# Defaults to /Users/hongss/.local/bin/claude if unset.
CLAUDE_BIN=
